# Copy to .env for local development: cp .env.example .env
# These values are for local Docker Compose only. Never reuse them anywhere else.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# PostgreSQL (the pgvector image)
POSTGRES_DB=ai_identity
POSTGRES_USER=ai_identity
POSTGRES_PASSWORD=ai_identity
DATABASE_URL=postgres://ai_identity:ai_identity@postgres:5432/ai_identity

# Redis (Celery broker and result backend)
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (MinIO locally; console at http://localhost:9001)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ai-identity-private
S3_REGION_NAME=us-east-1
