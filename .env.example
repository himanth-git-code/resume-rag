# Copy to .env for local development: cp .env.example .env
# These values are for local Docker Compose only. Never reuse them anywhere else.

# Host ports (change if already in use on your machine)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# PostgreSQL (the pgvector image)
POSTGRES_DB=ai_identity
POSTGRES_USER=ai_identity
POSTGRES_PASSWORD=ai_identity
DATABASE_URL=postgres://ai_identity:ai_identity@postgres:5432/ai_identity

# Redis (Celery broker and result backend)
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (SeaweedFS locally, S3 API at http://localhost:8333)
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-secret
S3_BUCKET_NAME=ai-identity-private
S3_REGION_NAME=us-east-1

# Google sign-in (optional). Leave empty to hide the "Continue with Google" button.
# Create a Web OAuth client in Google Cloud Console with redirect URI:
#   http://localhost:3000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI provider for resume parsing: "anthropic" (needs ANTHROPIC_API_KEY) or
# "fake" (no API calls; returns an empty draft, useful for UI work).
AI_PROVIDER=fake
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Embeddings for the knowledge base: "voyage" (needs VOYAGE_API_KEY) or
# "fake" (no API calls; search results aren't meaningful).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=voyage-4
VOYAGE_API_KEY=

# Resume uploads
RESUME_MAX_UPLOAD_MB=5
RESUME_MAX_PDF_PAGES=20
RESUME_UPLOAD_RATE=20/hour
